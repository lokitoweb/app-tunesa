# .env de PRODUCCIÓN (plantilla). El instalador web (/install) parte de este archivo y completa solo:
# APP_KEY, APP_URL, APP_DOMAIN, SANCTUM_STATEFUL_DOMAINS, SESSION_SECURE_COOKIE, los DB_*, APP_NAME,
# APP_TIMEZONE y MAIL_FROM_ADDRESS, con el dominio con el que se abre /install. Nunca subas el .env real a git.
APP_NAME="ERP"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=America/Lima
# Dominio final del panel y de la API (con https, sin barra final). La app móvil usa el mismo.
APP_URL=
# Dominio base para subdominios de empresas (empresa.midominio.com)
APP_DOMAIN=
# Respaldo del dominio de los correos de acceso [DNI]@dominio (también se configura en el panel)
LOGIN_EMAIL_DOMAIN=
# Asistente /install: al terminar escribe false aquí y deja storage/app/installed.lock
INSTALLER_ENABLED=true
# Nginx + PHP-FPM en el mismo servidor no es un proxy: basta 127.0.0.1.
# Detrás de Cloudflare (nube naranja) o un balanceador, pon sus IPs o '*'.
TRUSTED_PROXIES=127.0.0.1,::1

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_PE
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_STACK=single
LOG_LEVEL=warning
LOG_DEPRECATIONS_CHANNEL=null

# --- MySQL 8 / MariaDB 10.6+ ---
# Sesiones, caché y cola van en la misma base (tablas sessions, cache, jobs): sin bloqueos de archivo.
# MySQL 8 necesita log_bin_trust_function_creators=1 para el trigger de marcaciones (ver INSTALACION.md).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
# Dominios del panel por navegador, sin https:// (separados por coma)
SANCTUM_STATEFUL_DOMAINS=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
QUEUE_WORK_FROM_SCHEDULER=true
CACHE_STORE=database
CACHE_PREFIX=erp_

INTEGRATIONS_TIMEOUT=10
INTEGRATIONS_ALLOW_PRIVATE_URLS=false

# Correo: en 'log' los correos quedan en storage/logs (app:check-production lo avisa).
# Para enviarlos: MAIL_MAILER=smtp y los datos de tu proveedor, luego php artisan config:cache.
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"
NOTIFY_BY_MAIL=false

ATTENDANCE_REJECT_MOCK_LOCATION=true
ATTENDANCE_MAX_GPS_ACCURACY=100

LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
MOBILE_TOKEN_DAYS=30
MAX_DEVICES_PER_USER=3
SANCTUM_TOKEN_PREFIX=erp_

ATTENDANCE_DISK=private
DOCUMENTS_DISK=private
SIGNED_URL_MINUTES=5

# --- Opcionales: sin valor, la función queda apagada o con su valor por defecto ---
# Consulta de DNI y RUC (proveedor Migo): token del servicio contratado
MIGO_API_TOKEN=
# Facturación electrónica (Nubefact)
NUBEFACT_URL=
NUBEFACT_TOKEN=
# Geocodificación de marcaciones con OpenStreetMap: correo de contacto que pide su política de uso
NOMINATIM_EMAIL=
# Tasa del IGV y listas de bancos y AFP de la planilla (separadas por coma)
FINANCE_IGV_RATE=0.18
#PAYROLL_BANKS="BCP,BBVA,Interbank,Scotiabank,Banco de la Nación"
#PAYROLL_PENSION_FUNDS="AFP Integra,AFP Prima,AFP Profuturo,AFP Habitat"

# Solo para `php artisan db:seed --force` sin instalador (Super Admin inicial).
# Bórralos después y corre `php artisan config:cache` para sacarlos también de la caché.
SEED_SUPERADMIN_EMAIL=
SEED_SUPERADMIN_PASSWORD=
