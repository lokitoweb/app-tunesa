# .env de PRODUCCIÓN para https://group-cyp.com (plantilla). En el servidor:
#   cp .env.production.example .env && php artisan key:generate
# y completa los valores marcados con CAMBIAR (contraseñas y correo). Nunca subas el .env real a git.
APP_NAME="Grupo Negreiros"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=America/Lima
# Dominio final del panel y de la API (con https, sin barra final). La app móvil usa el mismo.
APP_URL=https://group-cyp.com
# Dominio base para subdominios de empresas (empresa.group-cyp.com)
APP_DOMAIN=group-cyp.com
# Respaldo del dominio de los correos de acceso [DNI]@dominio (también se configura en el panel)
LOGIN_EMAIL_DOMAIN=
# Ya instalado por consola: el asistente /install queda cerrado
INSTALLER_ENABLED=false
# Nginx + PHP-FPM en el mismo servidor no es un proxy: basta 127.0.0.1.
# Detrás de Cloudflare (nube naranja) o un balanceador, pon sus IPs o '*'.
TRUSTED_PROXIES=127.0.0.1,::1

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_PE
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_STACK=single
LOG_LEVEL=warning
LOG_DEPRECATIONS_CHANNEL=null

# --- MySQL 8 / MariaDB 10.6+ ---
# Sesiones, caché y cola van en la misma base (tablas sessions, cache, jobs): sin bloqueos de archivo.
# MySQL 8 necesita log_bin_trust_function_creators=1 para el trigger de marcaciones (ver la guía, paso 3).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tunesa
DB_USERNAME=tunesa
# CAMBIAR: contraseña larga y única
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
# Dominios del panel por navegador, sin https:// (separados por coma)
SANCTUM_STATEFUL_DOMAINS=group-cyp.com,www.group-cyp.com

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
QUEUE_WORK_FROM_SCHEDULER=true
CACHE_STORE=database
CACHE_PREFIX=tunesa_

INTEGRATIONS_TIMEOUT=10
INTEGRATIONS_ALLOW_PRIVATE_URLS=false

# Correo real (recuperación de contraseña, avisos). CAMBIAR
MAIL_MAILER=smtp
# CAMBIAR: datos SMTP de tu proveedor de correo
MAIL_HOST=smtp.CAMBIAR.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@group-cyp.com"
MAIL_FROM_NAME="${APP_NAME}"
NOTIFY_BY_MAIL=false

ATTENDANCE_REJECT_MOCK_LOCATION=true
ATTENDANCE_MAX_GPS_ACCURACY=100

LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
MOBILE_TOKEN_DAYS=30
MAX_DEVICES_PER_USER=3
SANCTUM_TOKEN_PREFIX=tunesa_

ATTENDANCE_DISK=private
DOCUMENTS_DISK=private
SIGNED_URL_MINUTES=5

# Solo para el primer `php artisan db:seed --force` (Super Admin inicial).
# Bórralos después y corre `php artisan config:cache` para sacarlos también de la caché.
SEED_SUPERADMIN_EMAIL=
SEED_SUPERADMIN_PASSWORD=
