APP_NAME=TuneSA
APP_ENV=local
# Se genera con: php artisan key:generate (no versionar una clave real)
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=America/Lima
APP_URL=http://localhost:8000
# Dominio base multi-tenant: las empresas se resuelven por subdominio (empresa.tunesa.app)
APP_DOMAIN=tunesa.app

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_PE

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Base de datos: sqlite para desarrollo local; en producción usar mysql o pgsql
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=tunesa
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Dominios desde los que el panel web usa Sanctum con cookies
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:8000,127.0.0.1,127.0.0.1:8000

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@tunesa.app"
MAIL_FROM_NAME="${APP_NAME}"

# --- Prototipo Node (serve_panel.js) ---
PORT=8000
# Super Admin inicial del prototipo: definir en .env, no versionar contraseñas reales
SUPERADMIN_EMAIL=superadmin@tunesa.app
SUPERADMIN_PASSWORD=
SUPERADMIN_NAME="Super Administrador General"
DEMO_TENANT_NAME="TuneSA Global SaaS"
DEMO_TENANT_DOMAIN=global.tunesa.app
HASH_SALT=

# Anti-fraude de marcación
ATTENDANCE_REJECT_MOCK_LOCATION=true
ATTENDANCE_MAX_GPS_ACCURACY=100

# --- Seguridad (Fase 3) ---
# HASH_DRIVER=argon2id          # por defecto argon2id si PHP lo soporta
LOGIN_MAX_ATTEMPTS=5            # fallos seguidos antes de bloquear la cuenta
LOGIN_LOCK_MINUTES=15
MOBILE_TOKEN_DAYS=30            # vigencia del token de la app
MAX_DEVICES_PER_USER=3
SANCTUM_TOKEN_PREFIX=tunesa_

# --- Archivos privados ---
ATTENDANCE_DISK=private         # selfies (private o s3)
DOCUMENTS_DISK=private          # legajo digital (private o s3)
SIGNED_URL_MINUTES=5            # vigencia de URLs firmadas / prefirmadas

# Solo para `php artisan db:seed` en producción: crea el Super Admin inicial
# (en local el seeder usa los usuarios demo). Bórralos después de sembrar.
SEED_SUPERADMIN_EMAIL=
SEED_SUPERADMIN_PASSWORD=
