<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>$(APP_DISPLAY_NAME) usa tu ubicación para verificar que estás dentro de la sucursal al marcar asistencia.</string>
	<key>NSCameraUsageDescription</key>
	<string>$(APP_DISPLAY_NAME) necesita la cámara frontal para tomar la selfie obligatoria de cada marcación.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>$(APP_DISPLAY_NAME) te permite elegir fotos de tu galería para adjuntar sustentos y documentos de tu legajo.</string>
	<!-- geolocator y camera enlazan las API de ubicación "siempre" y de micrófono aunque la app
	     no las usa (solo ubicación al marcar y selfie sin audio). App Store rechaza la subida
	     (ITMS-90683) si el binario las referencia sin texto de propósito. -->
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>$(APP_DISPLAY_NAME) usa tu ubicación solo al marcar asistencia, para verificar que estás dentro de la sucursal. No te ubica en segundo plano.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>$(APP_DISPLAY_NAME) no graba audio. La cámara se usa solo para la selfie de cada marcación.</string>
	<!-- Solo cifrado estándar del sistema (HTTPS, Keychain, SQLCipher para la cola local): exento de la declaración de exportación -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
	<key>NSAppTransportSecurity</key>
	<dict>
		<!-- Solo HTTPS hacia internet; http permitido únicamente en red local
		     (backend de desarrollo en localhost / IP de la LAN). -->
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>$(APP_DISPLAY_NAME)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(APP_DISPLAY_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>flutter</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
